<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>vn.edu.vku</groupId>
    <artifactId>mail-server-udp</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.2</javafx.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.3.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- Chạy Client: mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>vn.edu.vku.mailserver.client.MailClientApp</mainClass>
                </configuration>
                <executions>
                    <!-- Server UI (START/STOP, thống kê, log): mvn javafx:run@server-ui -->
                    <execution>
                        <id>server-ui</id>
                        <configuration>
                            <mainClass>vn.edu.vku.mailserver.server.ui.ServerApp</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Chạy Server dòng lệnh (không UI): mvn exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.1</version>
                <configuration>
                    <mainClass>vn.edu.vku.mailserver.server.MailServerApp</mainClass>
                </configuration>
                <executions>
                    <!-- Chạy FTP Server: mvn exec:java@ftp-server -->
                    <execution>
                        <id>ftp-server</id>
                        <configuration>
                            <mainClass>vn.edu.vku.mailserver.ftp.FtpServerApp</mainClass>
                        </configuration>
                    </execution>
                    <!-- Chạy FTP Client tương tác CLI: mvn exec:java@ftp-client -->
                    <execution>
                        <id>ftp-client</id>
                        <configuration>
                            <mainClass>vn.edu.vku.mailserver.ftp.client.FtpClientApp</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
